{
  "name": "larteystar6/pos-enterprise",
  "description": "POS Enterprise - Laravel + Vue PWA (scaffold)",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "laravel/framework": "^10.0"
  },
  "autoload": {
